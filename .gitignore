# Terraform state — contains sensitive data, never commit
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Variable files — may contain secrets
*.tfvars
!terraform.tfvars.example
!bootstrap/terraform.tfvars.example

# Plan files
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH keys — never commit private keys
*.pem
id_rsa
id_ed25519

# OS files
.DS_Store
Thumbs.db
